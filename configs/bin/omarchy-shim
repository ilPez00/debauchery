#!/bin/bash
# omarchy-shim — Omarchy's command names, backed by DMS / Hyprland / Debian.
#
# Omarchy's desktop scripts assume Omarchy's Quickshell shell on Arch. air runs
# DMS on Debian, so this file keeps the *interface* (names, arguments, exit
# codes) and retargets each verb. One file, symlinked per verb, deployed by
# debauchery/scripts/11-omarchy-shims.sh.
#
#   omarchy-shim --check        every verb and whether its backing tool exists
#   omarchy-shim --list         verb names only
#   omarchy-<verb> [args...]    dispatch on the invoked name
#
# Tier 1 only: the verbs muscle memory actually touches. omarchy-install-*,
# gaming, PAM and portal steps are deliberately not implemented (see
# docs/CONTRACT.md).
set -uo pipefail

SELF=$(basename "$0")
if [ "$SELF" = omarchy-shim ]; then
  VERB=${1:-help}; [ $# -gt 0 ] && shift
else
  VERB=${SELF#omarchy-}
fi

die()  { printf 'omarchy-%s: %s\n' "$VERB" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is missing — sudo apt install $2"; }

dms()  { need dms dms; command dms ipc call "$@"; }

# First token of Exec= in a .desktop id, from the user dir then the system one.
desktop_bin() {
  local id=$1 f
  for f in "$HOME/.local/share/applications/$id" "$HOME/.nix-profile/share/applications/$id" \
           "/usr/share/applications/$id"; do
    [ -r "$f" ] || continue
    sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$f" | head -1
    return 0
  done
  return 1
}

# The chromium-family browser to run web apps in: --app is not a Firefox flag.
webapp_browser() {
  local id bin
  id=$(xdg-settings get default-web-browser 2>/dev/null || true)
  case "$id" in
    chromium*|google-chrome*|brave*|microsoft-edge*|opera*|vivaldi*|helium*) ;;
    *) id="chromium.desktop" ;;
  esac
  bin=$(desktop_bin "$id") || bin=""
  [ -n "$bin" ] || bin=$(command -v chromium || command -v chromium-browser || true)
  [ -n "$bin" ] || return 1
  printf '%s\n' "$bin"
}

# The shell scans plugins only at startup: install and remove both need a
# restart before `plugin-list` tells the truth. Wait for IPC to answer.
dms_restart() {
  printf 'restarting dms.service (the shell only scans plugins at startup)\n'
  systemctl --user restart dms.service || die "could not restart dms.service"
  local i
  for i in $(seq 1 20); do
    command dms ipc call plugin-scan list >/dev/null 2>&1 && return 0
    sleep 1
  done
  die "dms did not answer after the restart"
}
hypr() { need hyprctl hyprland; hyprctl "$@"; }

# The deployed verb names. scripts/11-omarchy-shims.sh reads this list back with
# `omarchy-shim --list`, so there is exactly one place to add a verb.
VERBS="menu menu-keybindings menu-power menu-system menu-clipboard
capture-screenshot capture-screenrecording capture-text
brightness-display brightness-keyboard
audio-output-volume audio-output-switch audio-input-mute
media lock night-toggle theme-toggle notifications-toggle
toggle-touchpad layout-toggle window-close-all cmd-terminal-cwd
launch-browser
plugin-list plugin-install plugin-remove plugin-update plugin-lock
plugin-search
launch-webapp webapp-install webapp-list webapp-remove launch-or-focus
launch-terminal launch-editor launch-tui launch-or-focus-tui launch-files
theme-set theme-bg-set theme-bg-next"

# step <arg> -> "<op> <value>" for the dms brightness/audio verbs. The dms
# increment/decrement verbs take a bare number; set takes a percentage.
step() {
  local arg=${1:-up} def=${2:-5} v
  case "$arg" in
    ''|up|+)   printf 'increment %s' "$def" ;;
    down|-)    printf 'decrement %s' "$def" ;;
    +*)        v=${arg#+}; v=${v%\%}; printf 'increment %s' "$v" ;;
    -*)        v=${arg#-}; v=${v%\%}; printf 'decrement %s' "$v" ;;
    *%|*[0-9]) printf 'set %s' "$arg" ;;
    *)         die "usage: $SELF [+N%|-N%|N%|up|down]" ;;
  esac
}

verb_help() {
  cat <<'EOF'
omarchy-shim — Omarchy verbs on DMS + Debian (Tier 1)

  menu                    shell menu              (dms dankMenu)
  menu-keybindings        keybind overlay         (dms keybinds)
  menu-power              power menu              (dms powermenu)
  menu-clipboard          clipboard manager       (dms clipboard)
  capture-screenshot [region|full|all|window|last]
  capture-screenrecording start/stop a region recording (wf-recorder)
  capture-text            OCR a screen region to the clipboard (tesseract)
  brightness-display [+N%|-N%|N%|up|down]
  brightness-keyboard [up|down|cycle]
  audio-output-volume [+N|-N|N%|up|down]
  audio-output-switch     next output sink
  audio-input-mute
  media [play-pause|next|previous|play|pause|stop]
  lock
  night-toggle
  theme-toggle
  notifications-toggle
  toggle-touchpad [on|off]        (no arg = toggle)
  layout-toggle                   dwindle <-> master
  window-close-all
  cmd-terminal-cwd                cwd of the focused terminal
  launch-browser
  plugin-list                     installed plugins: id / state / kind / name
  plugin-search <term>            search the store listing
  plugin-install <id>             install, restart dms, enable, verify
  plugin-remove <id>              disable, then uninstall
  plugin-update [<id>|--all]      no arg = all
  plugin-lock                     pin every plugin into the repo lockfile
  launch-webapp <url>             the URL in a chromium --app window
  webapp-install <name> <url> [icon]   create the launcher (favicon fetched)
  webapp-list / webapp-remove <name>
  launch-or-focus <class> <cmd...>     focus that window class, else run cmd
  launch-terminal [dir]           open terminal (in dir, default cwd of focus)
  launch-editor [path]            $EDITOR/$VISUAL, TUI editors in a terminal
  launch-tui <cmd> [args...]      run command in a terminal window
  launch-or-focus-tui <cmd> [args...]  focus its terminal window, else launch
  launch-files [path]             open file manager (default: cwd of focus)
  theme-set [dark|light|toggle]
  theme-bg-set <image>            absolute path; validated before it is applied
  theme-bg-next                   next wallpaper in the rotation
  --check / --list

Not implemented on purpose: omarchy-install-*, gaming, PAM/portal writes.
EOF
}

verb_check() {
  local rc=0
  row() { # name state note [optional]
    local s=$2 opt=${4:-}
    [ "$opt" = optional ] && [ "$s" = missing ] && s="missing (optional)"
    printf '  %-28s %-19s %s\n' "$1" "$s" "$3"
    [ "$2" = missing ] && [ "$opt" != optional ] && rc=1
    return 0
  }
  has() { command -v "$1" >/dev/null 2>&1 && echo present || echo missing; }
  printf 'omarchy-shim backend check\n'
  row dms           "$(has dms)"           "ipc target for menu/audio/brightness/media/lock/theme"
  row hyprctl       "$(has hyprctl)"       "window + device + layout verbs"
  row jq            "$(has jq)"            "JSON parsing in the shims"
  row brightnessctl "$(has brightnessctl)" "keyboard backlight" optional
  row wl-copy       "$(has wl-copy)"       "capture-text output" optional
  row grim          "$(has grim)"          "capture-text screenshot" optional
  row slurp         "$(has slurp)"         "region selection" optional
  row tesseract     "$(has tesseract)"     "OCR (apt install tesseract-ocr)" optional
  row wf-recorder   "$(has wf-recorder)"   "screen recording (apt install wf-recorder)" optional
  row chromium      "$(has chromium)"      "web apps (chromium --app)" optional
  row uwsm-app      "$(has uwsm-app)"      "detaching launched windows" optional
  local v n=0
  for v in $VERBS; do [ -L "$HOME/.local/bin/omarchy-$v" ] && n=$((n + 1)); done
  printf '\n  %-28s %s/%s\n' "verbs installed" "$n" "$(printf '%s\n' $VERBS | wc -l)"
  [ "$n" -eq "$(printf '%s\n' $VERBS | wc -l)" ] || rc=1
  return $rc
}

case "$VERB" in
  help|-h|--help)        verb_help ;;
  --check|check)         verb_check ;;
  --list|list)           printf '%s\n' $VERBS ;;

  menu)                  dms dankMenu toggle root ;;
  menu-keybindings)      dms keybinds toggle hypr ;;
  menu-power|menu-system) dms powermenu toggle ;;
  menu-clipboard)        dms clipboard toggle ;;

  capture-screenshot)    need dms dms; dms screenshot "${1:-region}" ;;
  capture-screenrecording)
    need wf-recorder wf-recorder
    if pgrep -x wf-recorder >/dev/null 2>&1; then
      pkill -INT -x wf-recorder && printf 'recording stopped\n'
    else
      need slurp slurp
      out=$HOME/Videos/recording-$(date +%Y%m%d-%H%M%S).mp4
      mkdir -p "$HOME/Videos"
      region=$(slurp) || die "selection cancelled"
      wf-recorder -g "$region" -f "$out" >/dev/null 2>&1 &
      printf 'recording %s\n' "$out"
    fi ;;
  capture-text)
    need grim grim; need slurp slurp; need tesseract tesseract-ocr; need wl-copy wl-clipboard
    region=$(slurp) || die "selection cancelled"
    grim -g "$region" - | tesseract stdin stdout 2>/dev/null | wl-copy
    printf 'text copied to the clipboard\n' ;;

  brightness-display)    read -r op val <<<"$(step "${1:-up}" 5)"; dms brightness "$op" "$val" ;;
  brightness-keyboard)
    need brightnessctl brightnessctl
    dev=smc::kbd_backlight
    brightnessctl -l 2>/dev/null | grep -q "$dev" || die "no keyboard backlight ($dev)"
    case "${1:-cycle}" in
      up|+)    brightnessctl -d "$dev" set 10%+ ;;
      down|-)  brightnessctl -d "$dev" set 10%- ;;
      cycle)   brightnessctl -d "$dev" set 10%+ ;;
      *)       brightnessctl -d "$dev" set "$1" ;;
    esac ;;

  audio-output-volume)   read -r op val <<<"$(step "${1:-up}" 3)"; dms audio "$op" "$val" ;;
  audio-output-switch)   dms audio cycleoutput ;;
  audio-input-mute)      dms audio micmute ;;
  media)
    case "${1:-play-pause}" in
      play-pause|toggle) dms mpris playPause ;;
      play)              dms mpris play ;;
      pause)             dms mpris pause ;;
      next)              dms mpris next ;;
      previous|prev)     dms mpris previous ;;
      stop)              dms mpris stop ;;
      *)                 die "usage: $SELF [play-pause|next|previous|play|pause|stop]" ;;
    esac ;;

  lock)                  dms lock lock ;;
  night-toggle)          dms night toggle ;;
  theme-toggle)          dms theme toggle ;;
  notifications-toggle)  dms notifications toggleDoNotDisturb ;;

  toggle-touchpad)
    need hyprctl hyprland; need jq jq
    dev=$(hyprctl devices -j | jq -r '.mice[]?.name' | grep -m1 -E 'bcm|touchpad|trackpad') ||
      die "no touchpad found"
    state=${XDG_RUNTIME_DIR:-/tmp}/debauchery-touchpad
    cur=$(cat "$state" 2>/dev/null || echo on)
    case "${1:-}" in
      on)  want=on ;;
      off) want=off ;;
      '')  [ "$cur" = on ] && want=off || want=on ;;
      *)   die "usage: $SELF [on|off]" ;;
    esac
    [ "$want" = on ] && en=1 || en=0
    hyprctl keyword "device[$dev]:enabled" "$en" >/dev/null || die "hyprctl rejected device[$dev]"
    printf '%s\n' "$want" > "$state" 2>/dev/null || true
    printf 'touchpad %s (%s)\n' "$want" "$dev" ;;

  layout-toggle)
    need hyprctl hyprland
    cur=$(hyprctl getoption general:layout | awk '/^str:/{print $2}')
    [ "$cur" = master ] && want=dwindle || want=master
    hyprctl keyword general:layout "$want" >/dev/null && printf 'layout: %s\n' "$want" ;;

  window-close-all)
    need hyprctl hyprland; need jq jq
    n=0
    while read -r addr; do
      [ -n "$addr" ] || continue
      hyprctl dispatch closewindow "address:$addr" >/dev/null && n=$((n + 1))
    done < <(hyprctl clients -j | jq -r '.[].address')
    printf 'closed %s window(s)\n' "$n" ;;

  cmd-terminal-cwd)
    need hyprctl hyprland; need jq jq
    pid=$(hyprctl activewindow -j 2>/dev/null | jq -r '.pid // empty')
    if [ -n "$pid" ] && [ -e "/proc/$pid/cwd" ]; then
      readlink -f "/proc/$pid/cwd"
    else
      printf '%s\n' "$HOME"
    fi ;;

  launch-browser)
    if command -v dms >/dev/null 2>&1 && dms ipc call defaultApp browser >/dev/null 2>&1; then
      exit 0
    fi
    [ $# -gt 0 ] || die "no default browser configured; usage: $SELF <url>"
    need xdg-open xdg-utils
    xdg-open "$1" >/dev/null 2>&1 & ;;

  # --- DMS plugin store ------------------------------------------------------
  # Omarchy has no plugin store; DMS does. These verbs are the store with the
  # two traps handled: a new plugin is invisible until dms.service restarts,
  # and it arrives disabled.
  plugin-list)           need dms dms; command dms ipc call plugin-scan list ;;

  plugin-search)
    need dms dms
    [ $# -gt 0 ] || die "usage: $SELF <term>"
    reg=${DMS_PLUGIN_REGISTRY:-/tmp/dankdots-plugin-registry/official/plugins}
    # The registry is a git checkout of manifest json files; `dms plugins list`
    # fetches it. Searching the files is instant, offline, and shows the id that
    # `install` actually takes (the id is not the file name).
    [ -d "$reg" ] || command dms plugins list >/dev/null 2>&1 || die "registry not fetchable"
    if [ -d "$reg" ] && command -v jq >/dev/null 2>&1; then
      term=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
      jq -rs --arg t "$term" '
        map(select((.id + " " + .name + " " + (.category // "") + " " + (.description // ""))
                   | ascii_downcase | contains($t)))
        | sort_by(.id) | .[]
        | "\(.id)\t\(.name)\t\(.category // "?")\t\(.repo // "")"' "$reg"/*.json
    else
      command dms plugins list 2>/dev/null | awk -v t="$1" '
        BEGIN { RS=""; IGNORECASE=1 } index(tolower($0), tolower(t)) { print $0 "\n" }'
    fi ;;

  plugin-install)
    need dms dms
    [ $# -gt 0 ] || die "usage: $SELF <plugin-id>"
    id=$1
    command dms plugins install "$id" || die "install failed: $id"
    dms_restart
    command dms ipc call plugins enable "$id" || die "$id installed but enable failed"
    printf 'plugin %s: %s\n' "$id" "$(command dms ipc call plugins status "$id" 2>&1)" ;;

  plugin-remove)
    need dms dms
    [ $# -gt 0 ] || die "usage: $SELF <plugin-id>"
    command dms ipc call plugins disable "$1" >/dev/null 2>&1 || true
    out=$(command dms plugins uninstall "$1" 2>&1) || {
      printf '%s\n' "$out" >&2
      # Removing something already absent is not a failure.
      case "$out" in *"not installed"*) printf 'plugin %s: not installed\n' "$1"; exit 0 ;; esac
      die "uninstall failed: $1"
    }
    dms_restart
    printf 'plugin %s: removed\n' "$1" ;;

  plugin-update)
    need dms dms
    [ $# -gt 0 ] || set -- --all
    command dms plugins update "$@" ;;

  plugin-lock)
    need dms dms
    repo=${DEBAUCHERY_REPO:-$HOME/debauchery}
    if [ -d "$repo/configs" ]; then
      command dms plugins lock -o "$repo/configs/dms-plugins.lock.json" || die "lock failed"
      printf 'pinned %s plugins -> %s\n' \
        "$(jq '.plugins | length' "$repo/configs/dms-plugins.lock.json" 2>/dev/null || echo '?')" \
        "$repo/configs/dms-plugins.lock.json"
    else
      command dms plugins lock || die "lock failed"
    fi ;;

  # --- web apps (chromium --app + a .desktop launcher) -----------------------
  launch-webapp)
    [ $# -gt 0 ] || die "usage: $SELF <url>"
    url=$1; shift
    bin=$(webapp_browser) || { need xdg-open xdg-utils; exec xdg-open "$url"; }
    # uwsm-app detaches the window from the launching process when it is there.
    if command -v uwsm-app >/dev/null 2>&1; then
      exec uwsm-app -- "$bin" --app="$url" "$@"
    fi
    exec "$bin" --app="$url" "$@" ;;

  webapp-install)
    [ $# -ge 2 ] || die "usage: $SELF <name> <url> [icon|icon-url]"
    name=$1 url=$2 icon=${3:-}
    case "$url" in *://*) ;; *) url="https://$url" ;; esac
    apps=$HOME/.local/share/applications
    icons=$apps/icons
    mkdir -p "$icons"
    case "$icon" in
      "") icon_path=$icons/$name.png
          # google s2 answers 404 for domains without a favicon and 200 with an
          # empty body for others, so the file must be non-empty to be usable.
          host=$(printf '%s' "$url" | sed -E 's#^[a-z+]+://##; s#/.*$##')
          ok=0
          for src in "https://www.google.com/s2/favicons?domain=$host&sz=128" \
                     "https://icons.duckduckgo.com/ip3/$host.ico"; do
            if curl -fsSL -o "$icon_path" "$src" 2>/dev/null && [ -s "$icon_path" ]; then
              ok=1; break
            fi
          done
          [ "$ok" = 1 ] || { rm -f "$icon_path"; icon_path=web-browser; } ;;
      http://*|https://*) icon_path=$icons/$(basename "$icon"); 
          curl -fsSL -o "$icon_path" "$icon" || die "icon download failed: $icon" ;;
      /*) icon_path=$icon ;;
      *)  icon_path=$icon ;;
    esac
    cat > "$apps/$name.desktop" <<EOF
[Desktop Entry]
Version=1.0
Name=$name
Comment=$name
Exec=$HOME/.local/bin/omarchy-launch-webapp $url
Terminal=false
Type=Application
Icon=$icon_path
StartupNotify=true
EOF
    chmod +x "$apps/$name.desktop"
    update-desktop-database "$apps" >/dev/null 2>&1 || true
    printf 'web app "%s" -> %s (%s)\n' "$name" "$url" "$apps/$name.desktop" ;;

  webapp-list)
    apps=$HOME/.local/share/applications
    n=0
    for f in "$apps"/*.desktop; do
      [ -r "$f" ] || continue
      grep -q 'omarchy-launch-webapp' "$f" || continue
      name=$(sed -n 's/^Name=//p' "$f" | head -1)
      url=$(sed -n 's/^Exec=.*omarchy-launch-webapp //p' "$f" | head -1)
      printf '%-28s %s\n' "$name" "$url"
      n=$((n + 1))
    done
    [ "$n" -gt 0 ] || printf 'no web apps installed (omarchy-webapp-install <name> <url>)\n' ;;

  webapp-remove)
    [ $# -ge 1 ] || die "usage: $SELF <name>"
    apps=$HOME/.local/share/applications
    f=$apps/$1.desktop
    [ -f "$f" ] || die "no such web app: $1"
    grep -q 'omarchy-launch-webapp' "$f" || die "$1 is not a web app; refusing to remove it"
    rm -f "$f" "$apps/icons/$1.png"
    update-desktop-database "$apps" >/dev/null 2>&1 || true
    printf 'web app "%s": removed\n' "$1" ;;

  launch-or-focus)
    [ $# -ge 2 ] || die "usage: $SELF <window-class> <command...>"
    need hyprctl hyprland; need jq jq
    class=$1; shift
    addr=$(hyprctl clients -j | jq -r --arg c "$class" '
      [.[] | select((.class | ascii_downcase) | contains($c | ascii_downcase))] | .[0].address // empty')
    if [ -n "$addr" ]; then
      hyprctl dispatch focuswindow "address:$addr" >/dev/null && printf 'focused: %s\n' "$class"
    else
      exec "$@"
    fi ;;

  # --- launch: terminal / editor / tui / files ------------------------------
  launch-terminal)
    dir=${1:-$("$HOME/.local/bin/omarchy-cmd-terminal-cwd" 2>/dev/null || printf '%s' "$HOME")}
    [ -d "$dir" ] || dir=$HOME
    term=${TERMINAL:-}
    if [ -z "$term" ]; then
      for c in xdg-terminal-exec alacritty kitty foot gnome-terminal; do
        command -v "$c" >/dev/null 2>&1 && { term=$c; break; }
      done
    fi
    [ -n "$term" ] || die "no terminal found (set \$TERMINAL)"
    if command -v uwsm-app >/dev/null 2>&1; then
      exec uwsm-app -- "$term" --working-directory "$dir"
    fi
    exec "$term" --working-directory "$dir" ;;

  launch-tui)
    [ $# -gt 0 ] || die "usage: $SELF <command> [args...]"
    app="org.omarchy.$(basename "$1")"
    if command -v xdg-terminal-exec >/dev/null 2>&1; then
      exec setsid uwsm-app -- xdg-terminal-exec --app-id="$app" -e "$@"
    fi
    # fallback: terminal -e
    term=${TERMINAL:-alacritty}
    command -v "$term" >/dev/null 2>&1 || term=$(command -v alacritty kitty foot 2>/dev/null | head -1)
    [ -n "$term" ] || die "no terminal for TUI"
    exec setsid "$term" -e "$@" ;;

  launch-or-focus-tui)
    [ $# -gt 0 ] || die "usage: $SELF <command> [args...]"
    app="org.omarchy.$(basename "$1")"
    exec "$HOME/.local/bin/omarchy-launch-or-focus" "$app" "$HOME/.local/bin/omarchy-launch-tui" "$@" ;;

  launch-editor)
    ed=${VISUAL:-${EDITOR:-}}
    [ -n "$ed" ] || ed=nvim
    case "$ed" in
      nvim|vim|vi|nano|micro|hx|helix|fresh|kak|emacsclient)
        exec "$HOME/.local/bin/omarchy-launch-tui" "$ed" "$@" ;;
      *)
        if command -v uwsm-app >/dev/null 2>&1; then
          exec uwsm-app -- "$ed" "$@"
        fi
        exec "$ed" "$@" ;;
    esac ;;

  launch-files)
    dir=${1:-$("$HOME/.local/bin/omarchy-cmd-terminal-cwd" 2>/dev/null || printf '%s' "$HOME")}
    [ -e "$dir" ] || dir=$HOME
    exec xdg-open "$dir" ;;

  # --- look: mode and background --------------------------------------------
  theme-set)
    case "${1:-toggle}" in
      dark|light|toggle) dms theme "$1" ;;
      *) die "usage: $SELF [dark|light|toggle]" ;;
    esac ;;

  theme-bg-set)
    [ $# -gt 0 ] || die "usage: $SELF <image-path>"
    # `dms ipc call wallpaper set` takes a PATH, and turns it into a file:// URL
    # without checking it: a colour or a typo silently becomes a missing file.
    [ -f "$1" ] || die "no such image: $1"
    case "$1" in /*) ;; *) die "give an absolute path: $PWD/$1" ;; esac
    dms wallpaper set "$1" && printf 'background: %s\n' "$1" ;;

  theme-bg-next)
    dms wallpaper next && printf 'background: %s\n' "$(dms wallpaper get)" ;;

  *) die "no such verb (try: omarchy-shim --list)" ;;
esac
