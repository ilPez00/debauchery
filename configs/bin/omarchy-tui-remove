#!/bin/bash
# omarchy-tui-remove — remove TUI desktop launchers.
set -euo pipefail
ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications"

if (( $# == 0 )); then
  mapfile -d '' files < <(find "$DESKTOP_DIR" -maxdepth 1 -name '*.desktop' -print0 2>/dev/null)
  TUIS=()
  for file in "${files[@]}"; do
    grep -qE '^Exec=.*(xdg-terminal-exec).*-e' "$file" && TUIS+=("$(basename "${file%.desktop}")")
  done
  if ((${#TUIS[@]}==0)); then echo "No TUIs to remove."; exit 1; fi
  if command -v gum >/dev/null 2>&1; then
    mapfile -t APP_NAMES < <(printf '%s\n' "${TUIS[@]}" | sort | gum choose --no-limit --header "Select TUI(s) to remove")
  else
    printf 'Installed TUIs:\n'; printf '  %s\n' "${TUIS[@]}"; echo "usage: omarchy-tui-remove <name...>"; exit 1
  fi
else
  APP_NAMES=("$@")
fi

(( ${#APP_NAMES[@]} > 0 )) || { echo "No TUI names provided."; exit 1; }
for APP_NAME in "${APP_NAMES[@]}"; do
  rm -f "$DESKTOP_DIR/$APP_NAME.desktop" "$ICON_DIR/$APP_NAME.png" "$ICON_DIR/$APP_NAME.svg"
  echo "Removed $APP_NAME"
done
update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
