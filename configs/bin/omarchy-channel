#!/bin/bash
# omarchy-channel — debauchery tracks git; "channel" maps to branch.
REPO=${DEBAUCHERY_REPO:-$HOME/debauchery}
cd "$REPO" || exit 1
case "${1:-current}" in
  current|show|get) git rev-parse --abbrev-ref HEAD ;;
  set) [ -n "${2:-}" ] || { echo "usage: omarchy-channel set <branch>" >&2; exit 1; }; git checkout "$2" ;;
  *) echo "usage: omarchy-channel [current|set <branch>]" >&2; exit 1 ;;
esac
