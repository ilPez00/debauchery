#!/bin/bash
# omarchy-restart-app <name> — best-effort: restart dms or hyprland components.
case "${1:-}" in
  dms|shell|bar|waybar) exec systemctl --user restart dms.service ;;
  hyprland|hypr|binds|config) exec hyprctl reload ;;
  *) echo "usage: omarchy-restart-app <dms|hyprland>" >&2; exit 1 ;;
esac
