# Ensure arch-omarchy is running before any exported service starts.
# Installed by scripts/17-container-boot.sh (module: boxboot).
# A stale "Initialized" state after reboot makes plain `podman start` fail with
# "cannot start a container that has stopped". Clean runtime state first, but
# only when the container is not already running (cleanup would kill it).
[Unit]
Description=Ensure arch-omarchy distrobox container is running
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/bin/sh -c 'status=$(/usr/bin/podman inspect --format "{{.State.Status}}" arch-omarchy 2>/dev/null); if [ "$status" = running ]; then exit 0; fi; /usr/bin/podman container cleanup arch-omarchy >/dev/null 2>&1 || :; /usr/bin/podman start arch-omarchy'

[Install]
WantedBy=default.target
